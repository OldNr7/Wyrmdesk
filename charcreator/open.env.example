# Settings for the open Charaktererstellung (compose.open.yaml). Copy to open.env and fill in, then
#   docker compose -f compose.open.yaml --env-file open.env up -d --build
# In Komodo: put these into the stack's environment instead.

# Password of the administration (content, list of characters). Empty: generated on the first start,
# written to the log once and kept in the volume (/data/admin-password).
ADMIN_PASSWORD=

# Port on the host (the reverse proxy forwards to it).
OPEN_PORT=8455

# Language of the UI: de (default) or en.
UI_LANG=de

# Days without use before a player's characters are deleted.
OPEN_DAYS=30
# New collections ("Neuen Charakter erstellen") per address and hour; all collections at most;
# characters per collection.
OPEN_MAX_NEW_PER_HOUR=10
OPEN_MAX_COLLECTIONS=5000
OPEN_MAX_CHARACTERS=5

# Imprint and privacy policy, linked at the foot of every page.
IMPRINT_URL=https://www.wyrmdesk.ch/de/impressum/
PRIVACY_URL=https://www.wyrmdesk.ch/de/datenschutz/

# Where the Wyrmdesk content comes from. Empty: https://www.wyrmdesk.ch/inhalte/srd/
WYRMDESK_CONTENT_URL=
