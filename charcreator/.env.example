# Settings for the Charaktererstellung (compose.yaml in this folder). Copy to .env and fill in; .env is
# not checked in.

# Password of the administration. Empty: the first start generates one, writes it to the log once and
# keeps it in the volume (/data/admin-password). For Docker secrets set ADMIN_PASSWORD_FILE in
# the service's environment instead.
ADMIN_PASSWORD=

# Language of the UI: de (default) or en. Every browser can switch it in the page header.
UI_LANG=de
