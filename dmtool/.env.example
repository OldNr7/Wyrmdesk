# Settings for the server stack (compose.yaml in this folder). Copy to .env and fill in; .env is not
# checked in.

# Language of the UI: de (default) or en. Every browser can switch it in the page header.
UI_LANG=de

# Optional: DeepL API key for the German translation of the library (free plan keys end in ":fx").
# Empty: no translating.
DEEPL_API_KEY=

# Optional: where the Wyrmdesk content (SRD with German texts) is fetched from. Empty: wyrmdesk.ch.
# WYRMDESK_CONTENT_URL=https://home.wyrmdesk.ch/inhalte/srd/

# Optional (server stack only): host folder for the automatic backups; default is a Docker volume.
# BACKUP_HOST_DIR=/srv/wyrmdesk/backups
